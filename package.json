{
  "name": "mara-platform",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter server db:generate",
    "db:migrate": "pnpm --filter server db:migrate",
    "exercise:slice-a": "pnpm --filter server exercise:slice-a",
    "exercise:slice-b": "pnpm --filter server exercise:slice-b",
    "exercise:slice-c": "pnpm --filter server exercise:slice-c",
    "exercise:slice-d": "pnpm --filter server exercise:slice-d",
    "exercise:slice-e": "pnpm --filter server exercise:slice-e",
    "exercise:slice-f": "pnpm --filter server exercise:slice-f",
    "exercise:slice-g": "pnpm --filter server exercise:slice-g",
    "worker": "pnpm --filter server worker"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"],
    "overrides": {
      "zod": "3.25.76"
    }
  }
}
