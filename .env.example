MARA_PORT=3100

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_CERT_PEM_PATH=
AZURE_FRONTIER_DEPLOYMENT=gpt-5.1
AZURE_CHEAP_DEPLOYMENT=gpt-5.4-mini

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2:7b

# Optional polite-pool contact and citation API keys for the reference verifier.
MARA_CONTACT_EMAIL=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Master key for the AES-256-GCM provider-key vault. Generate a 32-byte key: openssl rand -hex 32
# Required only to persist provider keys on disk; session-only keys never touch it. Never commit a real value.
MARA_MASTER_KEY=

# On Windows use 127.0.0.1 rather than localhost so the client does not stall on IPv6 (::1) resolution.
GROBID_URL=http://127.0.0.1:8070
