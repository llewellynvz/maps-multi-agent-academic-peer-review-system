MARA_PORT=3100

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_CERT_PEM_PATH=
AZURE_FRONTIER_DEPLOYMENT=gpt-5.1
AZURE_CHEAP_DEPLOYMENT=gpt-5.4-mini

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2:7b

# Optional polite-pool contact and citation API keys for the reference verifier.
MARA_CONTACT_EMAIL=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://host.docker.internal:3000

# Master key for the AES-256-GCM provider-key vault. Generate a 32-byte key: openssl rand -hex 32
# Required only to persist provider keys on disk; session-only keys never touch it. Never commit a real value.
MARA_MASTER_KEY=

# Leave empty to use the built-in PDF fallback. Set to http://grobid:8070 to use the optional grobid compose profile.
GROBID_URL=

# How long a review may sit in awaiting_input before the worker pauses it. Default 86400000 (24 hours).
MARA_AWAITING_INPUT_TIMEOUT_MS=

# Per-model pricing override, USD per million tokens as input,cached,output. One variable per model,
# uppercased with non-alphanumerics replaced by underscores, e.g. MARA_PRICING_GPT_5_1=0.625,0.0625,5.00
# Models without a built-in or override entry record cost 0 and are invisible to the cost ceiling.

