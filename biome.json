{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "server/src/**/*.ts",
      "app/src/**/*.ts",
      "app/src/**/*.tsx",
      "packages/*/src/**/*.ts"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error",
        "noUnreachable": "error",
        "noConstantCondition": "error",
        "useExhaustiveDependencies": "off"
      },
      "suspicious": {
        "noDoubleEquals": "error",
        "noExplicitAny": "error",
        "noDebugger": "error",
        "noEmptyBlockStatements": "off",
        "noAsyncPromiseExecutor": "error",
        "noMisleadingInstantiator": "error",
        "useAwait": "off"
      },
      "security": {
        "noGlobalEval": "error"
      },
      "complexity": {
        "noUselessCatch": "error",
        "noForEach": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
